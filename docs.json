{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Overthinker",
  "fonts": {
    "family": "Pretendard Variable",
    "source": "/fonts/PretendardVariable.woff2",
    "format": "woff2"
  },
  "logo": {
    "light": "/brand/overthinker-logo-light.png",
    "dark": "/brand/overthinker-logo-dark.png"
  },
  "colors": {
    "primary": "#625582",
    "light": "#D3C9F1",
    "dark": "#6545A7"
  },
  "background": {
    "color": { "light": "#FFFFFF", "dark": "#272729" }
  },
  "appearance": { "default": "dark" },
  "navigation": {
    "languages": [
      {
        "language": "ko",
        "tabs": [
          {
            "tab": "서비스",
            "groups": [
              { "group": "시작하기", "pages": ["index", "quickstart", "product"] },
              { "group": "에이전트", "pages": ["ai/agents", "ai/voice", "ai/tools", "ai/knowledge", "ai/variables", "ai/evaluations"] },
              { "group": "운영", "pages": ["operations/channels", "operations/campaigns", "operations/conversations", "operations/monitoring"] },
              { "group": "계정", "pages": ["operations/integrations", "operations/billing", "operations/support", "operations/admin"] }
            ]
          },
          {
            "tab": "개발자",
            "pages": ["developers/index", "developers/keys", "developers/calls", "developers/web-chat"]
          },
          { "tab": "릴리즈노트", "pages": ["changelog"] }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Service",
            "groups": [
              { "group": "Getting started", "pages": ["en/index", "en/quickstart", "en/product"] },
              { "group": "Agents", "pages": ["en/ai/agents", "en/ai/voice", "en/ai/tools", "en/ai/knowledge", "en/ai/variables", "en/ai/evaluations"] },
              { "group": "Operations", "pages": ["en/operations/channels", "en/operations/campaigns", "en/operations/conversations", "en/operations/monitoring"] },
              { "group": "Account", "pages": ["en/operations/integrations", "en/operations/billing", "en/operations/support", "en/operations/admin"] }
            ]
          },
          {
            "tab": "Developers",
            "pages": ["en/developers/index", "en/developers/keys", "en/developers/calls", "en/developers/web-chat"]
          },
          { "tab": "Release notes", "pages": ["en/changelog"] }
        ]
      }
    ]
  }
}
